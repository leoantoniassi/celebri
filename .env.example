# ============================================================
# CELEBRI — variáveis de ambiente
# ============================================================
# Copie para .env e ajuste. O .env é ignorado pelo git.

# ── Banco de dados ──────────────────────────────────────────
DB_NAME=celebri
DB_USER=celebri
DB_PASS=troque-esta-senha
DB_PORT=5432

# ── Autenticação ────────────────────────────────────────────
# Gere um segredo próprio: openssl rand -hex 32
# Nunca versione este valor.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ── Frontend ────────────────────────────────────────────────
# Usado no CORS e para montar os links de convite/recuperação de senha.
FRONTEND_URL=http://localhost:8080

# ── E-mail transacional (convites e recuperação de senha) ───
EMAIL_HOST=
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Celebri <nao-responda@celebri.local>

# ── Ambiente ────────────────────────────────────────────────
# development liga o log de SQL; production exige SSL no banco.
NODE_ENV=development
