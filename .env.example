# ============================================================
# CELEBRI — variáveis de ambiente
# ============================================================
# Copie para .env e ajuste. O .env é ignorado pelo git.

# ── Banco de dados ──────────────────────────────────────────
DB_NAME=celebri
DB_USER=celebri
DB_PASS=troque-esta-senha
DB_PORT=5432
# SSL na conexão com o banco (Postgres gerenciado/externo). Padrão: ligado só em
# NODE_ENV=production quando DB_HOST não é interno (db/postgres/localhost/127.0.0.1).
# DB_SSL=true|false força o comportamento.
DB_SSL=
# CA do servidor (conteúdo PEM ou caminho do arquivo). Com CA o certificado é
# verificado (rejectUnauthorized=true). Sem CA, usa as CAs do sistema.
DB_SSL_CA=
# Só use false em último caso (desliga a verificação do certificado, aceita MITM;
# a API loga um aviso no start). Padrão: verificação ligada.
DB_SSL_REJECT_UNAUTHORIZED=

# ── Autenticação ────────────────────────────────────────────
# Gere um segredo próprio (mín. 32 caracteres):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Obrigatório: a API não sobe sem isso. Nunca versione nem reutilize este valor
# entre ambientes; troque-o (e a senha do banco) antes de publicar.
JWT_SECRET=
# Duração da sessão (padrão 8h).
JWT_EXPIRES_IN=8h

# Quantos proxies (nginx, load balancer) ficam à frente da API. Define de
# onde vem o IP do cliente (X-Forwarded-For) usado no rate limit de login.
# 0/vazio = sem proxy (padrão). Atrás de 1 nginx: 1. Nunca use um valor
# maior que o real, senão o IP pode ser forjado pelo cliente.
# Rate limit e bloqueio de conta ficam em memória (por instância da API).
TRUST_PROXY=0

# ── Frontend ────────────────────────────────────────────────
# Origem do frontend: usada no CORS e nos links de convite/recuperação de senha.
# OBRIGATÓRIA em produção (NODE_ENV=production): a API não sobe sem ela.
# Aceita várias origens separadas por vírgula (a primeira é usada nos links).
# Nunca use "*". Em dev, se vazia, o CORS aceita http://localhost:5173/3000/8080.
# Deve ser a origem que o navegador usa (porta do host = WEB_PORT, padrão 8080).
# Se mudar WEB_PORT, ajuste aqui também.
FRONTEND_URL=http://localhost:8080

# ── Documentos locais ───────────────────────────────────────
# Pasta base dos arquivos de documentos com "caminho local". Cada empresa usa a
# subpasta <DOCUMENTOS_DIR>/<empresaId>/ e o caminho cadastrado é RELATIVO a ela
# (ex.: contratos/contrato.pdf). Caminhos absolutos e ".." são rejeitados.
# Padrão (se vazio): backend/uploads/documentos. No Docker: /app/uploads/documentos.
DOCUMENTOS_DIR=

# ── E-mail transacional (convites e recuperação de senha) ───
EMAIL_HOST=
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Celebri <nao-responda@celebri.local>
# Só desenvolvimento, sem SMTP: true loga o código de primeiro acesso (apenas o
# código, sem e-mail) no console da API para testar o app mobile. Padrão: false.
# É ignorado quando NODE_ENV=production.
DEV_LOG_CODIGO_ACESSO=false

# ── Ambiente ────────────────────────────────────────────────
# development: log de SQL e erros detalhados; sem SSL no banco local. Use só
#   na máquina de dev (este .env.example é o ponto de partida do dev-up).
# production: sem log de SQL nem detalhes de erro, SSL no banco externo,
#   FRONTEND_URL obrigatória. É o padrão do docker-compose se esta variável
#   não for definida. Em qualquer ambiente publicado use production.
NODE_ENV=development

# ── LGPD (docs/lgpd) ────────────────────────────────────────
# Versão dos termos/política gravada no aceite do usuário. Mude ao publicar novo texto.
TERMOS_VERSAO=1.0
# Purge de retenção (npm run purge:retencao, manual): dias, mínimo 30.
RETENCAO_DIAS=1825
RETENCAO_CONVITES_DIAS=180
# Backup (scripts/backup.sh): configure BACKUP_DIR, BACKUP_RETENCAO_DIAS e BACKUP_PASSPHRASE
# no ambiente do cron/servidor (NÃO neste .env: a senha do backup não deve ficar junto da aplicação).
# Ver docs/lgpd/politica-de-backup.md.
